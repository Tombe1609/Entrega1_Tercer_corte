# Copie este archivo como ".env" y ajuste los valores (el archivo .env NO se sube a GitHub).

# Puerto de la API
PORT=3000

# Orígenes web permitidos por CORS (separados por coma).
# En producción, reemplace estos ejemplos por el dominio HTTPS real del frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000

# MongoDB Atlas seed list (reemplace los hosts y replicaSet por los de su clúster).
# El marcador <db_password> se reemplaza con MONGODB_PASSWORD y se codifica automáticamente.
MONGODB_URI=mongodb://USUARIO:<db_password>@HOST0:27017,HOST1:27017,HOST2:27017/?tls=true&authSource=admin&replicaSet=REPLICA_SET&retryWrites=true&w=majority
MONGODB_PASSWORD=

DB_NAME=cooperativa_universitaria

# development muestra el detalle de errores internos; production lo oculta
NODE_ENV=development

# Secreto para firmar los tokens de inicio de sesión (cambia este valor antes de producción).
# Usa una cadena aleatoria larga y privada; no publiques el archivo .env.
AUTH_TOKEN_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_LARGO

# Contraseña temporal usada solo por el script local seed:login-demo (mínimo 12 caracteres)
DEMO_LOGIN_PASSWORD=

# Monto máximo por préstamo (regla de ejemplo del TXT: 5.000.000)
LIMITE_PRESTAMO=5000000
